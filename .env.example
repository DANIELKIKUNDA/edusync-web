# dev | staging | production. staging and production run every safety check (HTTPS origins, explicit hosts,
# no demonstration secret, MFA key, Secure cookie, no simulated provider).
EDUSYNC_ENV=dev
# Owner is used ONLY by the one-shot migrator/provisioner container, never by the API.
EDUSYNC_OWNER_DATABASE_URL=postgresql+psycopg://edusync_owner:CHANGE_OWNER_PASSWORD@postgres:5432/edusync
EDUSYNC_TENANT_DATABASE_URL=postgresql+psycopg://edusync_tenant:CHANGE_TENANT_PASSWORD@postgres:5432/edusync
EDUSYNC_PLATFORM_DATABASE_URL=postgresql+psycopg://edusync_platform:CHANGE_PLATFORM_PASSWORD@postgres:5432/edusync
# Background workers (outbox, SMS): dedicated least-privilege role, created by the migrator. Never the owner.
EDUSYNC_WORKER_DATABASE_URL=postgresql+psycopg://edusync_worker:CHANGE_WORKER_PASSWORD@postgres:5432/edusync
EDUSYNC_REDIS_URL=redis://redis:6379/0
EDUSYNC_JWT_SECRET=CHANGE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_0123456789
EDUSYNC_JWT_ISSUER=edusync
EDUSYNC_JWT_AUDIENCE=edusync-web
EDUSYNC_ACCESS_TOKEN_MINUTES=30
# Ne passer à true qu’après G3 multi-caissier + adapter Finance canonique certifiés.
EDUSYNC_OFFLINE_FINANCE_ENABLED=false
EDUSYNC_OFFLINE_FINANCE_CERTIFIED=false
# Persistent device session: an approved device stays signed in (0 = no periodic re-authentication).
# The token rotates at every renewal; reuse, revocation, password change or deactivation end the session.
EDUSYNC_SESSION_ABSOLUTE_DAYS=0
EDUSYNC_SESSION_IDLE_DAYS=0
# Documents: any S3-compatible storage (SeaweedFS/Garage self-hosted, Cloudflare R2, Backblaze B2, AWS S3).
# The bucket must stay PRIVATE; EduSync only hands out signed links valid a few minutes.
EDUSYNC_OBJECT_STORAGE_ENDPOINT=http://object-storage:8333
EDUSYNC_OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
EDUSYNC_OBJECT_STORAGE_SECRET_KEY=CHANGE_ME_SECRET_KEY
EDUSYNC_OBJECT_STORAGE_BUCKET=edusync-documents
EDUSYNC_OBJECT_STORAGE_REGION=us-east-1
EDUSYNC_OBJECT_STORAGE_PATH_STYLE=true
# First Manager Système from the login page of an EMPTY installation (staging/production: mandatory,
# one-time, known only to the operator; remove it once the first manager exists).
EDUSYNC_SETUP_TOKEN=
# Leave EDUSYNC_PLATFORM_ADMIN_PASSWORD empty to create the first manager from the login page instead.
EDUSYNC_PLATFORM_ADMIN_EMAIL=admin@example.com
EDUSYNC_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_NOW_123!
EDUSYNC_PLATFORM_ADMIN_NAME=Administrateur Atelier Pro
EDUSYNC_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# staging/production: the public domain(s) + localhost (container health check), e.g. staging.example.cd,localhost
EDUSYNC_TRUSTED_HOSTS=localhost,127.0.0.1
# Platform TOTP secrets at rest: 32 random bytes, base64 (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())").
# Mandatory in staging/production and different from the JWT secret.
EDUSYNC_MFA_ENCRYPTION_KEY=
# Signed document links (empty = derived from the JWT secret; set an explicit random value in staging/production).
EDUSYNC_DOCUMENT_LINK_SECRET=
# Reverse proxies allowed to set X-Forwarded-For: fixed addresses of nginx (frontend) and of the TLS terminator.
EDUSYNC_FORWARDED_ALLOW_IPS=172.30.57.10,172.30.57.11
# Public HTTPS (docker compose --profile tls): domain pointing at this server and the Let's Encrypt contact.
EDUSYNC_DOMAIN=
EDUSYNC_ACME_EMAIL=
# Backups (service "backup"): daily, 14 days kept locally; off-site copy through any rclone remote (empty = none).
EDUSYNC_BACKUP_INTERVAL_SECONDS=86400
EDUSYNC_BACKUP_KEEP_DAYS=14
EDUSYNC_BACKUP_OFFSITE=
EDUSYNC_BACKUP_OFFSITE_TYPE=s3
EDUSYNC_BACKUP_OFFSITE_PROVIDER=Other
EDUSYNC_BACKUP_OFFSITE_ENDPOINT=
EDUSYNC_BACKUP_OFFSITE_ACCESS_KEY=
EDUSYNC_BACKUP_OFFSITE_SECRET_KEY=
# ---------------------------------------------------------------- External messaging (names only, never real values)
# Real providers stay EXTERNAL_REQUIRED until their secrets are provided and the real probes pass. "fake" exists only for
# development and is refused in staging / production. Secrets go to the secret store of the deployment (e.g. Coolify),
# never into Git, the frontend bundle or a screenshot.
# Public address of the application, used in invitation / recovery links sent by e-mail (HTTPS outside development).
EDUSYNC_PUBLIC_APP_URL=
# SMS — Orange Developer SMS API: disabled | orange | fake
EDUSYNC_SMS_PROVIDER=disabled
EDUSYNC_ORANGE_SMS_CLIENT_ID=
EDUSYNC_ORANGE_SMS_CLIENT_SECRET=
# Country sender address of the Orange offer, e.g. tel:+2430000 for DR Congo
EDUSYNC_ORANGE_SMS_SENDER_ADDRESS=
# Custom sender name whitelisted by Orange (11 alphanumeric characters max), empty = default sender
EDUSYNC_ORANGE_SMS_SENDER_NAME=
# Delivery receipts: unguessable path secret (24+ random characters) of https://<domaine>/api/v1/webhooks/orange/sms-dr/<secret>
EDUSYNC_ORANGE_SMS_DR_SECRET=
# Source IPs communicated by Orange for delivery receipts (comma separated)
EDUSYNC_ORANGE_SMS_DR_ALLOWED_IPS=
# E-mail — SMTP relay: disabled | smtp | fake
EDUSYNC_EMAIL_PROVIDER=disabled
EDUSYNC_SMTP_HOST=
EDUSYNC_SMTP_PORT=587
EDUSYNC_SMTP_USERNAME=
EDUSYNC_SMTP_PASSWORD=
EDUSYNC_SMTP_FROM_EMAIL=
EDUSYNC_SMTP_FROM_NAME=EduSync
# starttls (port 587) | tls (port 465)
EDUSYNC_SMTP_SECURITY=starttls
# Push — Firebase Cloud Messaging: disabled | fcm | fake
EDUSYNC_PUSH_PROVIDER=disabled
# Backend service account (SECRET): path of a mounted file, or the JSON injected by the deployment tool
EDUSYNC_FCM_SERVICE_ACCOUNT_FILE=
EDUSYNC_FCM_SERVICE_ACCOUNT_JSON=
# Public Firebase web app configuration (JSON with apiKey, projectId, messagingSenderId, appId) and Web Push public key
EDUSYNC_FCM_WEB_CONFIG_JSON=
EDUSYNC_FCM_VAPID_PUBLIC_KEY=
# Account links lifetime (server side)
EDUSYNC_INVITATION_TTL_HOURS=48
EDUSYNC_PASSWORD_RESET_TTL_MINUTES=30
VITE_API_BASE_URL=http://localhost:8000/api/v1
POSTGRES_DB=edusync
POSTGRES_OWNER_USER=edusync_owner
POSTGRES_OWNER_PASSWORD=CHANGE_OWNER_PASSWORD
# Staging deployment script (deploy/staging/remote_deploy.sh): true = public TLS by the Caddy service (profile tls)
EDUSYNC_DEPLOY_TLS_PROFILE=false
