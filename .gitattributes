# Binary evidence and assets must never be touched by end-of-line conversion.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
*.zip binary
*.woff2 binary

# Scripts executed inside Linux containers keep LF endings.
*.sh text eol=lf
Caddyfile text eol=lf

# CI/CD scripts executed on Linux runners / servers keep LF endings.
*.yml text eol=lf
deploy/staging/privileged/* text eol=lf
